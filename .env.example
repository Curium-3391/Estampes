# Copy to .env and edit. Every setting is optional; the defaults work.

# Host port Docker publishes (the server listens on 8787 inside the container).
ESTAMPES_HOST_PORT=8787

# Public https address ChatGPT reaches this server at, e.g. through a
# reverse proxy or tunnel. Used for download links; empty = taken from the
# incoming request.
PUBLIC_BASE_URL=

# Shared secret. When set, the ChatGPT connector URL must be
# https://your-host/mcp?key=THIS_VALUE (or send "Authorization: Bearer ...").
ESTAMPES_ACCESS_KEY=

# Where images, marks, layers, SVGs and history are written. compose.yaml
# fixes this to /data (the volume); set it yourself only outside Docker.
# ESTAMPES_STORAGE_DIR=./data

# Delete stored images nobody touched for this many days (0 = keep forever).
ESTAMPES_STORAGE_RETENTION_DAYS=0

# Image limits.
ESTAMPES_MAX_IMAGE_MB=20
ESTAMPES_MAX_IMAGE_MEGAPIXELS=50
# Long side of the working copy every coordinate refers to.
ESTAMPES_WORKING_LONG_SIDE=4096

# Memory cache of decoded images (disk keeps the rest when storage is on).
ESTAMPES_CACHE_MB=160
ESTAMPES_CACHE_IMAGES=12
ESTAMPES_CACHE_TTL_MINUTES=60

# Requests per minute per client IP on /mcp (0 = off).
ESTAMPES_RATE_LIMIT_PER_MIN=120
# Comma-separated browser origins allowed to call /mcp ("*" = any).
ESTAMPES_CORS_ORIGINS=*

# text or json (one JSON object per log line).
ESTAMPES_LOG_FORMAT=text
